<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.studybuddy.controller.RegisterController"
      alignment="CENTER" spacing="20" prefWidth="400" prefHeight="300">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Create Account" style="-fx-font-size: 24; -fx-font-weight: bold;" />

    <TextField fx:id="usernameField" promptText="Choose Username" prefWidth="200" />
    <PasswordField fx:id="passwordField" promptText="Choose Password" prefWidth="200" />
    <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" prefWidth="200" />

    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="registerButton" text="Register" onAction="#handleRegister" prefWidth="80" />
        <Button fx:id="backButton" text="Back to Login" onAction="#handleBack" prefWidth="100" />
    </HBox>

    <Label fx:id="messageLabel" textFill="RED" />
</VBox>
