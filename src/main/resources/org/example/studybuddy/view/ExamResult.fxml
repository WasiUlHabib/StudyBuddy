<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.studybuddy.controller.ExamResultController">

    <top>
        <HBox spacing="20" alignment="CENTER" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <Label text="Exam Results" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="25">
                <padding>
                    <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                </padding>

                <!-- Exam Info -->
                <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label fx:id="examNameLabel" text="Exam Name" style="-fx-font-size: 20; -fx-font-weight: bold;" />
                    <Label fx:id="completedDateLabel" text="Completed: " style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;" />
                </VBox>

                <!-- Score Summary -->
                <HBox spacing="20" alignment="CENTER">
                    <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 20; -fx-background-radius: 10;" prefWidth="150">
                        <Label text="Score" style="-fx-font-size: 16; -fx-text-fill: white;" />
                        <Label fx:id="scoreLabel" text="0.0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;" />
                    </VBox>

                    <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 20; -fx-background-radius: 10;" prefWidth="150">
                        <Label text="Correct" style="-fx-font-size: 16; -fx-text-fill: white;" />
                        <Label fx:id="correctLabel" text="0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;" />
                    </VBox>

                    <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 20; -fx-background-radius: 10;" prefWidth="150">
                        <Label text="Wrong" style="-fx-font-size: 16; -fx-text-fill: white;" />
                        <Label fx:id="wrongLabel" text="0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;" />
                    </VBox>

                    <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 20; -fx-background-radius: 10;" prefWidth="150">
                        <Label text="Unanswered" style="-fx-font-size: 16; -fx-text-fill: white;" />
                        <Label fx:id="unansweredLabel" text="0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;" />
                    </VBox>
                </HBox>

                <!-- Performance Chart -->
                <VBox spacing="10">
                    <Label text="Performance Breakdown" style="-fx-font-size: 18; -fx-font-weight: bold;" />
                    <PieChart fx:id="performanceChart" prefHeight="300" />
                </VBox>

                <!-- Detailed Results -->
                <VBox spacing="15">
                    <Label text="Question Review" style="-fx-font-size: 18; -fx-font-weight: bold;" />
                    <ScrollPane prefHeight="400">
                        <VBox fx:id="questionsReviewContainer" spacing="15" />
                    </ScrollPane>
                </VBox>

                <!-- Action Buttons -->
                <HBox spacing="20" alignment="CENTER">
                    <Button fx:id="dashboardButton" text="Back to Dashboard" onAction="#goToDashboard"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14;"
                            prefWidth="150" prefHeight="40" />
                    <Button fx:id="takeAnotherButton" text="Take Another Exam" onAction="#takeAnotherExam"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14;"
                            prefWidth="150" prefHeight="40" />
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
