<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.studybuddy.controller.ExamController">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Label fx:id="examNameLabel" text="Exam Name" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Time Remaining:" style="-fx-text-fill: white; -fx-font-size: 14;" />
            <Label fx:id="timerLabel" text="60:00" style="-fx-text-fill: #e74c3c; -fx-font-size: 20; -fx-font-weight: bold;" />
        </HBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
            </padding>

            <!-- Question Navigation -->
            <HBox spacing="10" alignment="CENTER">
                <Label text="Question:" style="-fx-font-size: 16; -fx-font-weight: bold;" />
                <Label fx:id="questionNumberLabel" text="1" style="-fx-font-size: 16; -fx-font-weight: bold;" />
                <Label text="of" style="-fx-font-size: 16;" />
                <Label fx:id="totalQuestionsLabel" text="10" style="-fx-font-size: 16; -fx-font-weight: bold;" />
            </HBox>

            <!-- Question Content -->
            <VBox spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 25; -fx-background-radius: 10;">
                <Label fx:id="questionTextLabel" text="Question text will appear here" wrapText="true"
                       style="-fx-font-size: 16; -fx-font-weight: bold;" />

                <!-- Answer Options -->
                <VBox fx:id="optionsContainer" spacing="15">
                    <RadioButton fx:id="optionA" text="Option A" toggleGroup="$answerGroup"
                                 style="-fx-font-size: 14;" />
                    <RadioButton fx:id="optionB" text="Option B" toggleGroup="$answerGroup"
                                 style="-fx-font-size: 14;" />
                    <RadioButton fx:id="optionC" text="Option C" toggleGroup="$answerGroup"
                                 style="-fx-font-size: 14;" />
                    <RadioButton fx:id="optionD" text="Option D" toggleGroup="$answerGroup"
                                 style="-fx-font-size: 14;" />
                </VBox>
            </VBox>

            <!-- Navigation Buttons -->
            <HBox spacing="15" alignment="CENTER">
                <Button fx:id="previousButton" text="← Previous" onAction="#handlePrevious"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14;"
                        prefWidth="120" prefHeight="35" />
                <Button fx:id="nextButton" text="Next →" onAction="#handleNext"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14;"
                        prefWidth="120" prefHeight="35" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="submitButton" text="Submit Exam" onAction="#handleSubmit"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"
                        prefWidth="130" prefHeight="35" />
            </HBox>

            <!-- Question Grid for Navigation -->
            <VBox spacing="10">
                <Label text="Question Navigator:" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                <ScrollPane prefHeight="100">
                    <GridPane fx:id="questionGridPane" hgap="5" vgap="5" />
                </ScrollPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>
