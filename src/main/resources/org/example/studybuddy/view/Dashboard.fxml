<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.studybuddy.controller.DashboardController">

    <top>
        <MenuBar>
            <Menu text="Navigation">
                <MenuItem text="Dashboard" onAction="#goToDashboard" />
                <MenuItem text="Question Bank" onAction="#goToQuestionBank" />
                <MenuItem text="Rooms" onAction="#goToRooms" />
                <MenuItem text="Profile" onAction="#goToProfile" />
                <SeparatorMenuItem />
                <MenuItem text="Logout" onAction="#handleLogout" />
            </Menu>
            <Menu text="Test Data">
                <MenuItem text="Add Sample Performance Data" onAction="#addTestData" />
            </Menu>


        </MenuBar>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="20">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>

                <!-- Welcome Section -->
                <VBox alignment="CENTER" spacing="10">
                    <Label fx:id="welcomeLabel" text="Welcome!" style="-fx-font-size: 24; -fx-font-weight: bold;" />
                    <Label fx:id="joinDateLabel" text="" style="-fx-font-size: 12; -fx-text-fill: gray;" />
                </VBox>

                <!-- Statistics Cards -->
                <HBox spacing="20" alignment="CENTER">
                    <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #e3f2fd; -fx-padding: 20; -fx-background-radius: 10;">
                        <Label text="Questions Attempted" style="-fx-font-size: 12; -fx-text-fill: #666;" />
                        <Label fx:id="attemptedLabel" text="0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1976d2;" />
                    </VBox>

                    <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #e8f5e8; -fx-padding: 20; -fx-background-radius: 10;">
                        <Label text="Questions Solved" style="-fx-font-size: 12; -fx-text-fill: #666;" />
                        <Label fx:id="solvedLabel" text="0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #388e3c;" />
                    </VBox>

                    <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #fff3e0; -fx-padding: 20; -fx-background-radius: 10;">
                        <Label text="Exams Taken" style="-fx-font-size: 12; -fx-text-fill: #666;" />
                        <Label fx:id="examsLabel" text="0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #f57c00;" />
                    </VBox>

                    <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #fce4ec; -fx-padding: 20; -fx-background-radius: 10;">
                        <Label text="Overall Accuracy" style="-fx-font-size: 12; -fx-text-fill: #666;" />
                        <Label fx:id="accuracyLabel" text="0%" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #c2185b;" />
                    </VBox>
                </HBox>

                <!-- Performance Graph Section -->
                <VBox spacing="10">
                    <Label text="Performance Over Time" style="-fx-font-size: 18; -fx-font-weight: bold;" />
                    <LineChart fx:id="performanceChart" prefHeight="300" createSymbols="true">
                        <xAxis>
                            <CategoryAxis fx:id="dateAxis" label="Date" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="valueAxis" label="Questions" lowerBound="0" upperBound="20" tickUnit="5" />
                        </yAxis>
                    </LineChart>
                </VBox>

                <!-- Action Buttons -->
                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="takeExamButton" text="Take Exam Now" onAction="#handleTakeExam"
                            style="-fx-font-size: 16; -fx-background-color: #4caf50; -fx-text-fill: white; -fx-background-radius: 5;"
                            prefWidth="150" prefHeight="40" />
                    <Button fx:id="refreshStatsButton" text="Refresh Stats" onAction="#refreshStats"
                            style="-fx-font-size: 14; -fx-background-color: #2196f3; -fx-text-fill: white; -fx-background-radius: 5;"
                            prefWidth="120" prefHeight="35" />
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
